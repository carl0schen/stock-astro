---
// src/pages/contact/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout
    title="聯絡我們"
    description="如果您對本站的法人買賣超數據有疑問，或發現資料錯誤，歡迎透過此頁面聯絡我們。"
>
  <div class="contact-page-container">
    <h1 class="page-title">聯絡我們</h1>

    <p class="info-text">
      <strong>✉️ 有話想對我們說嗎？</strong><br>
      如果對本站的法人買賣超數據有疑問，或發現資料錯誤，歡迎透過下方表單聯絡我們。<br>
      我們收到訊息後會盡快處理！
    </p>

    <form id="contact-form" action="https://api.staticforms.dev/submit" method="POST">
        <input type="hidden" name="accessKey" value="sf_2f7f5630gckb73dd6g1g2jmd">
        <input type="hidden" name="subject" value="來自 stock.may.tw 的新聯絡訊息">

        <div class="ohnohoney">
            <label for="honeypot">請勿填寫此欄位</label>
            <input type="text" id="honeypot" name="honeypot" autocomplete="off">
        </div>

        <div class="form-group">
            <label for="name" class="form-label">名稱 <span class="required-mark">*</span></label>
            <input type="text" id="name" name="name" class="form-input" placeholder="您的名稱" required>
        </div>

        <div class="form-group">
            <label for="email" class="form-label">電子信箱 <span class="required-mark">*</span></label>
            <input type="email" id="email" name="email" class="form-input" placeholder="name@example.com" required>
        </div>

        <div class="form-group">
            <label for="message" class="form-label">訊息內容 <span class="required-mark">*</span></label>
            <textarea id="message" name="message" class="form-textarea" placeholder="請輸入您的訊息..." required></textarea>
        </div>

        <div class="submit-wrapper">
          <button type="submit" id="submit-btn" class="submit-button">送出訊息</button>
        </div>

        <div id="form-message" class="form-message" role="status" aria-live="polite" style="display: none;"></div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const formMessage = document.getElementById('form-message') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = '傳送中...';
      submitBtn.style.opacity = '0.7';
      formMessage.style.display = 'none';
      formMessage.className = 'form-message';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: JSON.stringify(data),
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        });

        const result = await response.json();

        if (result.success) {
          formMessage.textContent = '✓ 訊息已成功送出！感謝您的聯繫。';
          formMessage.classList.add('success');
          formMessage.style.display = 'block';
          form.reset();

          setTimeout(() => {
            formMessage.classList.add('fade-out');
            setTimeout(() => {
              formMessage.style.display = 'none';
              formMessage.classList.remove('success', 'error', 'fade-out');
            }, 500);
          }, 6000);

        } else {
          formMessage.textContent = '送出失敗，請檢查內容或稍後再試。';
          formMessage.classList.add('error');
          formMessage.style.display = 'block';
        }
      } catch (error) {
        formMessage.textContent = '網路連線異常，請稍後再試。';
        formMessage.classList.add('error');
        formMessage.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = '送出訊息';
        submitBtn.style.opacity = '1';
      }
    });
  }
</script>

<style>
  .contact-page-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 2em 1rem 4em 1rem;
  }

  .page-title {
    font-size: 1.8em;
    text-align: center;
    border-bottom: 2px solid #eaeaea;
    padding-bottom: 0.5em;
    margin-top: 0;
    margin-bottom: 1.5em;
    color: #24292e;
  }

  .info-text {
    font-size: 0.95rem;
    color: #444;
    background-color: #f6f8fa;
    padding: 1.2rem 1.5rem;
    border-radius: 6px;
    margin-bottom: 2.5rem;
    text-align: left;
    line-height: 1.8;
  }
  .info-text strong {
    color: #0366d6;
  }

  .form-group {
    margin-bottom: 1.5rem;
    text-align: left;
  }
  .form-label {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #333;
  }
  .required-mark { color: #d73a49; }

  .form-input, .form-textarea {
    width: 100%;
    padding: 0.9rem 1.2rem;
    font-size: 1.1rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    box-sizing: border-box;
    font-family: inherit;
    background-color: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-textarea {
    height: 150px;
    resize: vertical;
  }

  .form-input:focus, .form-textarea:focus {
    border-color: #0366d6;
    box-shadow: 0 0 0 3px rgba(3, 102, 214, 0.1);
    outline: none;
  }

  .submit-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .submit-button {
    padding: 0.9rem 3rem;
    font-size: 1.1rem;
    background-color: #0366d6;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: background-color 0.2s;
  }
  .submit-button:hover { background-color: #024ea4; }
  .submit-button:disabled { cursor: not-allowed; }

  .ohnohoney {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    height: 0;
    width: 0;
    z-index: -1;
  }

  .form-message {
    margin-top: 1.5rem;
    padding: 1rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 500;
    animation: fadeIn 0.3s ease-in;
    text-align: center;
  }

  .form-message.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-message.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .form-message.fade-out {
    animation: fadeOut 0.5s ease-out forwards;
  }

  @keyframes fadeOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-5px); }
  }

  @media (max-width: 480px) {
    .submit-button {
      width: 100%;
    }
  }
</style>
