---
import Layout from '../../layouts/Layout.astro';
---

<Layout
    title="全站資料搜尋"
    description="利用關鍵字查詢台股法人買賣超日報、週報與月報的歷史資料。"
>
  <div class="search-page-container">
    <h1 class="page-title">全站關鍵字搜尋</h1>

    <p class="info-text">
      <strong>🔍 找報表？輸入日期自動跳轉：</strong><br>
      支援格式：20261019、2026/10/19、2026年10月19日、2026W42、2026M09<br><br>
      <strong>🔍 找全文？使用關鍵字搜尋：</strong><br>
      輸入關鍵字全文搜尋（例如：台積電、"2026年10月19日"、PCB）。
    </p>

    <div class="search-bar-wrapper">
      <input type="text" id="searchInput" placeholder="輸入關鍵字或日期..." autofocus>
      <button id="searchBtn">搜尋</button>
    </div>
    <p id="errorMsg" class="error-msg"></p>

    <div id="resultsWrapper" style="display: none;">
      <div id="resultCount" class="result-count"></div>
      <div id="resultsList"></div>
      <button id="loadMoreBtn" class="load-more-btn" style="display: none;">載入更多</button>
    </div>
  </div>
</Layout>

<script is:inline>
  const searchInput = document.getElementById('searchInput');
  const searchBtn = document.getElementById('searchBtn');
  const errorMsg = document.getElementById('errorMsg');
  const resultsWrapper = document.getElementById('resultsWrapper');
  const resultsList = document.getElementById('resultsList');
  const resultCount = document.getElementById('resultCount');
  const loadMoreBtn = document.getElementById('loadMoreBtn');

  let allResults = [];
  let currentPage = 0;
  const RESULTS_PER_PAGE = 15;

  async function performSearch() {
    if (!searchInput) return;
    const query = searchInput.value.trim();
    const formatQuery = query.toUpperCase();

    if (!query) {
      if (errorMsg) {
        errorMsg.textContent = '請輸入搜尋關鍵字！';
        errorMsg.style.display = 'block';
      }
      return;
    }

    if (errorMsg) errorMsg.style.display = 'none';

    if (/^\d{8}$/.test(formatQuery)) {
      const y = formatQuery.substring(0, 4);
      const m = formatQuery.substring(4, 6);
      const d = formatQuery.substring(6, 8);
      window.location.href = `/${y}/${m}/${d}/`;
      return;
    } else if (/^\d{4}W\d{1,2}$/.test(formatQuery)) {
      const y = formatQuery.substring(0, 4);
      const w = formatQuery.substring(formatQuery.indexOf('W') + 1);
      window.location.href = `/${y}/weekly/${w}/`;
      return;
    } else if (/^\d{4}M\d{1,2}$/.test(formatQuery)) {
      const y = formatQuery.substring(0, 4);
      const m = formatQuery.substring(formatQuery.indexOf('M') + 1);
      window.location.href = `/${y}/monthly/${m}/`;
      return;
    }

    const naturalDaily = formatQuery.match(/^(\d{4})[年\/\-\s]+0?(\d{1,2})[月\/\-\s]+0?(\d{1,2})[日號]?$/);
    if (naturalDaily) {
      const y = naturalDaily[1];
      const m = naturalDaily[2].padStart(2, '0');
      const d = naturalDaily[3].padStart(2, '0');
      window.location.href = `/${y}/${m}/${d}/`;
      return;
    }

    const naturalMonthly = formatQuery.match(/^(\d{4})[年\/\-\s]+0?(\d{1,2})月?$/);
    if (naturalMonthly) {
      const y = naturalMonthly[1];
      const m = naturalMonthly[2].padStart(2, '0');
      window.location.href = `/${y}/monthly/${m}/`;
      return;
    }

    const naturalWeekly = formatQuery.match(/^(\d{4})[年\s]*第?(\d{1,2})[週周]$/);
    if (naturalWeekly) {
      const y = naturalWeekly[1];
      const w = naturalWeekly[2];
      window.location.href = `/${y}/weekly/${w}/`;
      return;
    }

    if (searchBtn) searchBtn.textContent = '搜尋中...';

    try {
      const pagefindUrl = window.location.origin + "/pagefind/pagefind.js";
      const pagefind = await import(/* @vite-ignore */ pagefindUrl);
      await pagefind.init();
      await pagefind.options({ excerptLength: 100 });

      const search = await pagefind.search(query);
      allResults = search.results;
      currentPage = 0;

      if (resultsList) resultsList.innerHTML = '';
      if (resultsWrapper) resultsWrapper.style.display = 'block';
      if (resultCount) resultCount.textContent = `找到 ${allResults.length} 筆結果`;

      await renderResults();
    } catch (e) {
      console.error(e);
      if (errorMsg) {
        errorMsg.textContent = '無法載入搜尋引擎，請確保網站已完成靜態建置。';
        errorMsg.style.display = 'block';
      }
    } finally {
      if (searchBtn) searchBtn.textContent = '搜尋';
    }
  }

  async function renderResults() {
    const start = currentPage * RESULTS_PER_PAGE;
    const end = start + RESULTS_PER_PAGE;
    const pageResults = allResults.slice(start, end);

    if (resultsList) {
      for (const result of pageResults) {
        const data = await result.data();
        const itemDiv = document.createElement('div');
        itemDiv.className = 'news-item';

        let innerHTML = `<a href="${data.url}" class="news-title-link"><h2>${data.meta.title || '無標題'}</h2></a>`;

        if (data.sub_results && data.sub_results.length > 0) {
          innerHTML += `<div class="excerpts-wrapper">`;
          for (const sub of data.sub_results) {
             if (!sub.excerpt) continue;
             innerHTML += `<p class="news-summary">${sub.excerpt}...</p>`;
          }
          innerHTML += `</div>`;
        } else {
          innerHTML += `<div class="excerpts-wrapper"><p class="news-summary">${data.excerpt}...</p></div>`;
        }

        itemDiv.innerHTML = innerHTML;
        resultsList.appendChild(itemDiv);
      }
    }

    if (loadMoreBtn) {
      if (end < allResults.length) {
        loadMoreBtn.style.display = 'block';
        currentPage++;
      } else {
        loadMoreBtn.style.display = 'none';
      }
    }
  }

  if (searchBtn) searchBtn.addEventListener('click', performSearch);
  if (loadMoreBtn) loadMoreBtn.addEventListener('click', renderResults);
  if (searchInput) {
    searchInput.addEventListener('keypress', function(event) {
      if (event.key === 'Enter') performSearch();
    });
  }
</script>

<style>
  .search-page-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 2em 1rem 4em 1rem;
  }

  .page-title {
    font-size: 1.8em;
    text-align: center;
    border-bottom: 2px solid #eaeaea;
    padding-bottom: 0.5em;
    margin-top: 0;
    margin-bottom: 1.5em;
    color: #24292e;
  }

  .info-text {
    font-size: 0.95rem;
    color: #444;
    background-color: #f6f8fa;
    padding: 1.2rem 1.5rem;
    border-radius: 6px;
    border: 1px solid #e1e4e8;
    margin-bottom: 2.5rem;
    text-align: left;
    line-height: 1.8;
  }
  .info-text strong {
    color: #0366d6;
  }

  .search-bar-wrapper {
    display: flex;
    gap: 0.8rem;
    margin-bottom: 3rem;
  }

  #searchInput {
    flex: 1;
    padding: 0.9rem 1.2rem;
    font-size: 1.1rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    background-color: #fff;
  }

  #searchInput:focus {
    border-color: #0366d6;
    box-shadow: 0 0 0 3px rgba(3, 102, 214, 0.1);
  }

  #searchBtn {
    padding: 0 2rem;
    font-size: 1.1rem;
    background-color: #0366d6;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  #searchBtn:hover {
    background-color: #024ea4;
  }

  .error-msg {
    color: #d73a49;
    font-size: 1rem;
    text-align: center;
    margin-top: -1.5rem;
    margin-bottom: 2rem;
    display: none;
  }

  .result-count {
    color: #586069;
    font-size: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eaeaea;
  }

  .news-item {
    border-bottom: 1px solid #eaeaea;
    padding-bottom: 2em;
    margin-bottom: 2.5em;
    animation: fadeIn 0.3s ease-in;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .news-item:last-child {
    border-bottom: none;
  }

  .news-title-link {
    color: #24292e;
    text-decoration: none;
    transition: color 0.2s;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .news-title-link h2 {
    font-size: 1.4em;
    font-weight: 600;
    margin: 0;
  }

  .news-title-link:hover h2 {
    color: #0366d6;
    text-decoration: underline;
  }

  .excerpts-wrapper {
    border-left: 4px solid #e1e4e8;
    padding-left: 1.2rem;
    margin-top: 0.5rem;
  }

  .news-summary {
    line-height: 1.8;
    color: #444;
    margin-bottom: 1.2rem;
    font-size: 0.95rem;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    word-break: break-all;
  }

  .news-summary:last-child {
    margin-bottom: 0;
  }

  .news-summary mark {
    background-color: #fff8c5;
    color: #24292e;
    font-weight: bold;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }

  .load-more-btn {
    display: block;
    margin: 3rem auto 0 auto;
    padding: 0.8rem 3rem;
    background-color: #f6f8fa;
    color: #24292e;
    border: 1px solid #e1e4e8;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s;
  }

  .load-more-btn:hover {
    background-color: #e1e4e8;
  }

  @media (max-width: 480px) {
    .search-bar-wrapper {
      flex-direction: column;
      gap: 1rem;
    }
    #searchBtn {
      padding: 1rem;
      width: 100%;
    }
    .info-text {
      font-size: 0.9rem;
      padding: 1rem;
    }
  }
</style>
